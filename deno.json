{
  "workspace": [
    "./packages/bluesky",
    "./packages/mastodon"
  ],
  "imports": {
    "@hooksmith/core": "jsr:@hooksmith/core@^0.4.0",
    "@hooksmith/http": "jsr:@hooksmith/http@^0.4.0",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "minimumDependencyAge": 0,
  "tasks": {
    "check": "deno fmt --check && deno lint && deno test -A && deno task check:examples",
    "check:examples": "deno run --allow-read --allow-run scripts/check_examples.ts",
    "test": "deno test -A"
  },
  "lock": false
}
